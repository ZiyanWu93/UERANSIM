# Makefile for Phase 3 testing

CC = gcc
CFLAGS = -Wall -Wextra -g -I.. -I../../../src/nflambda/event_system
LDFLAGS = 

# Source files
PHASE3_SRCS = phase3_handlers.c
TEST_SRCS = test_phase3.c

# Object files
PHASE3_OBJS = $(PHASE3_SRCS:.c=.o)
TEST_OBJS = $(TEST_SRCS:.c=.o)

# Target
TARGET = ../bin/test_phase3

# Default target
all: $(TARGET)

# Build the test executable
$(TARGET): $(PHASE3_OBJS) $(TEST_OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

# Compile source files
%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

# Run the test
test: $(TARGET)
	./$(TARGET)

# Clean build artifacts
clean:
	rm -f $(PHASE3_OBJS) $(TEST_OBJS) $(TARGET)

.PHONY: all test clean