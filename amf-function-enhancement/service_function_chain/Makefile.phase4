# Makefile for Phase 4 testing

CC = gcc
CFLAGS = -Wall -Wextra -g -I.. -I../../../src/nflambda/event_system
LDFLAGS = 

# Source files
PHASE4_SRCS = phase4_handlers.c
TEST_SRCS = test_phase4.c

# Object files
PHASE4_OBJS = $(PHASE4_SRCS:.c=.o)
TEST_OBJS = $(TEST_SRCS:.c=.o)

# Target
TARGET = ../bin/test_phase4

# Default target
all: $(TARGET)

# Build the test executable
$(TARGET): $(PHASE4_OBJS) $(TEST_OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

# Compile source files
%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

# Run the test
test: $(TARGET)
	./$(TARGET)

# Clean build artifacts
clean:
	rm -f $(PHASE4_OBJS) $(TEST_OBJS) $(TARGET)

.PHONY: all test clean