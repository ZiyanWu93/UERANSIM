# Makefile for Phase 1 testing

CC = gcc
CFLAGS = -Wall -Wextra -g -I.. -I../../../src/nflambda/event_system
LDFLAGS = 

# Source files
PHASE1_SRCS = phase1_handlers.c
TEST_SRCS = test_phase1.c

# Object files
PHASE1_OBJS = $(PHASE1_SRCS:.c=.o)
TEST_OBJS = $(TEST_SRCS:.c=.o)

# Target
TARGET = ../bin/test_phase1

# Default target
all: $(TARGET)

# Build the test executable
$(TARGET): $(PHASE1_OBJS) $(TEST_OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

# Compile source files
%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

# Run the test
test: $(TARGET)
	./$(TARGET)

# Clean build artifacts
clean:
	rm -f $(PHASE1_OBJS) $(TEST_OBJS) $(TARGET)

.PHONY: all test clean