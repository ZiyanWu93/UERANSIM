# Makefile for Phase 2 testing

CC = gcc
CFLAGS = -Wall -Wextra -g -I.. -I../../../src/nflambda/event_system
LDFLAGS = 

# Source files
PHASE2_SRCS = phase2_handlers.c
TEST_SRCS = test_phase2.c

# Object files
PHASE2_OBJS = $(PHASE2_SRCS:.c=.o)
TEST_OBJS = $(TEST_SRCS:.c=.o)

# Target
TARGET = ../bin/test_phase2

# Default target
all: $(TARGET)

# Build the test executable
$(TARGET): $(PHASE2_OBJS) $(TEST_OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

# Compile source files
%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

# Run the test
test: $(TARGET)
	./$(TARGET)

# Clean build artifacts
clean:
	rm -f $(PHASE2_OBJS) $(TEST_OBJS) $(TARGET)

.PHONY: all test clean